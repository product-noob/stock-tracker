# Database credentials used by docker-compose.yml
POSTGRES_PASSWORD=

# LLM API key used by extraction/ranking scripts
OPENAI_API_KEY=

# Full connection string used by DB-writing scripts (e.g. seed_core.py):
# postgresql://stocktracker:<POSTGRES_PASSWORD>@localhost:5433/stocktracker
DATABASE_URL=

# NSE/BSE API schedule; positive divisor of 24. Default: four IST slots/day.
EXCHANGE_CAPTURE_INTERVAL_HOURS=6

# Integration tests do not read their target from this file. Inject TEST_DATABASE_URL,
# TEST_OBJECT_ROOT, and STOCKTRACKER_TEST_MODE=1 in the test process only; see
# docs/testing.md. Never point them at DATABASE_URL or data/objects/.
