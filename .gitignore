.env
venv/
__pycache__/
*.pyc
.DS_Store

# Raw PDFs are re-downloadable from exchanges; keep them out of git history
data/*/pdfs/
data/*/pdf_test/

# Session cookies / auth artifacts
cookies.txt

# Persistent content-addressed object store blobs (immutable; back up separately)
data/objects/

backups/
tmp/

# Disposable integration-test object roots and local deletion manifests
.stocktracker-test-object-root
*deletion-manifest*.json

# Credential-bearing debris from mis-rooted object stores must never be tracked
postgresql:*
*stocktracker:*@*
